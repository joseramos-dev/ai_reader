root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
# Las funciones @Composable se nombran en PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml}]
indent_size = 2

# El código que genera KSP (Room) vive en build/ y no sigue las reglas de estilo.
[**/build/**]
ktlint = disabled
