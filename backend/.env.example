# Copy to .env and adjust values as needed.

# Language/model selection
# Options: english, spanish, spanish_24l, french_24l, italian_24l, german_24l, portuguese_24l
TTS_LANGUAGE=spanish_24l

# Default voice when none is specified in the request
# For spanish: lola
TTS_DEFAULT_VOICE=lola

# Apply int8 quantization to reduce RAM usage (~half the memory, slight quality trade-off)
TTS_QUANTIZE=true

# Server bind
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated list, or ["*"] for all)
CORS_ORIGINS=["*"]

# Ollama (chapter detection and summaries)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
